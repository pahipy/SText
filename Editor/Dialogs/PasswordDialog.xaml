<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="SText.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SText.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="0"
        MinWidth="0"
        ShowInTaskbar="False"
        Title="Type a password" Height="255" Width="335">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="91"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid Height="40" Grid.Row="0">
            <Label x:Name="Header" Margin="15,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Type a password"/>
        </Grid>
        <Label Grid.Row="1" Margin="10,0">
            <Label.Content>
                <TextBlock FontSize="15" TextWrapping="WrapWithOverflow">
                    Please, type a password to encrypt/decrypt current file.
                </TextBlock>
            </Label.Content>
        </Label>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <ui:PasswordBox PlaceholderText="Type a password" TabIndex="0" HorizontalAlignment="Left" Margin="10,5" MinWidth="313" x:Name="Passwd" Grid.Row="0"/>
            <ui:PasswordBox PlaceholderText="Retype a password" TabIndex="1" HorizontalAlignment="Left" Margin="10,5" MinWidth="313" x:Name="RetypedPasswd" Grid.Row="1"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="OK" IsEnabled="False" Grid.Column="0" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Content="OK" Click="Buttons_Click" />
            <ui:Button x:Name="Cancel" Grid.Column="1" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Cancel" Click="Buttons_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
